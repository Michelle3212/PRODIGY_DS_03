<div class="TyagGW_tableContainer"><div tabindex="-1" class="group TyagGW_tableWrapper flex flex-col-reverse w-fit"><table data-start="997" data-end="1121" class="w-fit min-w-(--thread-content-width)"><thead data-start="997" data-end="1019"><tr data-start="997" data-end="1019"><th data-start="997" data-end="1004" data-col-size="sm" class="">Step</th><th data-start="1004" data-end="1019" data-col-size="sm" class="">What you do</th></tr></thead><tbody data-start="1041" data-end="1121"><tr data-start="1041" data-end="1066"><td data-start="1041" data-end="1045" data-col-size="sm">1</td><td data-col-size="sm" data-start="1045" data-end="1066">Upload <code data-start="1054" data-end="1064">bank.csv</code></td></tr><tr data-start="1067" data-end="1093"><td data-start="1067" data-end="1071" data-col-size="sm">2</td><td data-col-size="sm" data-start="1071" data-end="1093">Run <code data-start="1077" data-end="1091">os.listdir()</code></td></tr><tr data-start="1094" data-end="1121"><td data-start="1094" data-end="1098" data-col-size="sm">3</td><td data-start="1098" data-end="1121" data-col-size="sm">Run <code data-start="1104" data-end="1119">pd.read_csv()</code></td></tr></tbody></table><div class="sticky h-0 select-none end-(--thread-content-margin) self-end"><div class="absolute end-0 flex items-end" style="height: 33.3281px;"><span class="" data-state="closed"><button aria-label="Copy table" class="hover:bg-token-bg-tertiary text-token-text-secondary my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-00d8790d.svg#ce3544" fill="currentColor"></use></svg></button></span></div></div></div></div>
